/*
 * Wobkey Crush 80 — ZMK keymap
 *
 * Base is a plain 80% layout: every key does what it says, Caps is Caps Lock, and
 * there are no hold-taps and no combos. Everything extra sits behind the Fn key, which is a
 * plain hold, and every layer here can be edited in VIA.
 *
 *   hold Fn              system controls + navigation (the HJKL cluster)
 *   hold Fn and Space    numpad and bracket symbols
 *   hold right Win       numpad on the nav cluster; add Space for the Macro layer (P)
 *   Fn+M                 Mac mode on / off (modifiers in Mac order, Cmd shortcuts)
 *   Fn+V                 Vim editing on / off (layer 6: hjkl, dd, yy, p, u, v ...)
 *
 * Layers (the number is what VIA and ZMK Studio show)
 *   0 Base    1 Mac     2 Fn      3 MacFn   4 Num     5 Macro   6 Vim     7 Visual
 *   8-10 operator layers (d y c, last one key)   11-13 spare (empty, yours)
 *
 * The order matters, and it is checked by ZMK from the highest layer down: Fn
 * must sit above Mac so Mac cannot swallow Fn's keys, MacFn above Fn and Num above
 * MacFn so each can override the one below it, and spare layers last (ZMK numbers
 * enabled layers first). Bump CONFIG_CRUSH80_KEYMAP_REV when you change the layer
 * list: it clears live edits (VIA, Studio) saved for the old layout.
 */

/* Build every ZMK behavior, not only the ones this file references, so that
 * ZMK Studio and VIA can assign them (&to, &lt, &mt, &sk, ...). The
 * studio-rpc-usb-uart snippet normally defines this; the Bluetooth Studio
 * transport used here does not. Must come before behaviors.dtsi. */
#define ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <rainy_rgb.dtsi>
#include <via_macro.dtsi>
#include <dt-bindings/rainy_rgb.h>

#define BASE  0
#define MAC   1
#define FN    2
#define MACFN 3
#define NUM   4
#define MACRO  5
#define VIM    6
#define VISUAL 7
#define OPD    8
#define OPY    9
#define OPC    10

/ {
	/* Vim editing behaviors (layers 6-10 below). Macros are timed 10 ms per step. */
	macros {
		m_i_big: m_i_big {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp HOME &tog VIM>;
		};

		m_a: m_a {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp RIGHT &tog VIM>;
		};

		m_a_big: m_a_big {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp END &tog VIM>;
		};

		m_o: m_o {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp END &kp RET &tog VIM>;
		};

		m_o_big: m_o_big {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp HOME &kp RET &kp UP &tog VIM>;
		};

		vim_s: vim_s {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp DEL &tog VIM>;
		};

		m_d_big: m_d_big {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LS(END) &kp DEL>;
		};

		m_c_big: m_c_big {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LS(END) &kp DEL &tog VIM>;
		};

		m_vline: m_vline {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp HOME &kp LS(END) &tog VISUAL>;
		};

		op_dd: op_dd {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp HOME &kp LS(END) &kp LC(X) &kp DEL>;
		};

		op_d_end: op_d_end {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LS(END) &kp DEL>;
		};

		op_d_home: op_d_home {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LS(HOME) &kp DEL>;
		};

		op_yy: op_yy {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp HOME &kp LS(END) &kp LC(C) &kp LEFT>;
		};

		op_yw: op_yw {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LC(LS(RIGHT)) &kp LC(C) &kp LEFT>;
		};

		op_y_end: op_y_end {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LS(END) &kp LC(C) &kp LEFT>;
		};

		op_cc: op_cc {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp HOME &kp LS(END) &kp DEL &tog VIM>;
		};

		op_cw: op_cw {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LC(DEL) &tog VIM>;
		};

		op_c_end: op_c_end {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LS(END) &kp DEL &tog VIM>;
		};

		vis_y: vis_y {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LC(C) &kp LEFT &tog VISUAL>;
		};

		vis_d: vis_d {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LC(X) &tog VISUAL>;
		};

		vis_c: vis_c {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LC(X) &tog VISUAL &tog VIM>;
		};

		vis_p: vis_p {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp LC(V) &tog VISUAL>;
		};

		vis_end: vis_end {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings = <&kp RIGHT &tog VISUAL>;
		};
	};

	behaviors {
		vim_g: vim_g {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp LC(HOME)>, <&kp LC(END)>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_x: vim_x {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp DEL>, <&kp BSPC>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_i: vim_i {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&tog VIM>, <&m_i_big>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_a: vim_a {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&m_a>, <&m_a_big>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_o: vim_o {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&m_o>, <&m_o_big>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_d: vim_d {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&sl OPD>, <&m_d_big>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_c: vim_c {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&sl OPC>, <&m_c_big>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_y: vim_y {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&sl OPY>, <&op_yy>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		vim_v: vim_v {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&tog VISUAL>, <&m_vline>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};

		/* Vim and Visual: a key pressed with Ctrl, Alt or Win held is just that key, so Ctrl+C,
		 * Ctrl+W, Alt+Tab, Win+E and the like keep working. */
		pv_H: pv_H {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp LEFT>, <&kp H>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		pv_J: pv_J {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp DOWN>, <&kp J>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		pv_K: pv_K {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp UP>, <&kp K>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
