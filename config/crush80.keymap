			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_MINUS: ps_MINUS {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp MINUS>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_EQUAL: ps_EQUAL {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp EQUAL>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_BSLH: ps_BSLH {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp BSLH>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_SEMI: ps_SEMI {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp SEMI>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_SQT: ps_SQT {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp SQT>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_COMMA: ps_COMMA {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp COMMA>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_DOT: ps_DOT {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp DOT>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};

		ps_FSLH: ps_FSLH {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&none>, <&kp FSLH>;
			mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
			keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		/*
		 * Layer 0: Base. Plain 80%, nothing else. Fn opens layer 2.
		 */
		default_layer {
			display-name = "Base";
			bindings = <
				&kp ESC          &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12          &kp F13          &kp PSCRN        &kp SLCK         &kp PAUSE_BREAK
				&kp GRAVE        &kp N1           &kp N2           &kp N3           &kp N4           &kp N5           &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &kp MINUS        &kp EQUAL        &kp BSPC         &kp INS          &kp HOME         &kp PG_UP
				&kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P            &kp LBKT         &kp RBKT         &kp BSLH         &kp DEL          &kp END          &kp PG_DN
				&kp CAPS         &kp A            &kp S            &kp D            &kp F            &kp G            &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp SQT          &kp RET
				&kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &kp RSHFT        &kp UP
				&kp LCTRL        &kp LGUI         &kp LALT         &kp SPACE        &kp RALT         &mo FN           &mo MACFN        &kp RCTRL        &kp LEFT         &kp DOWN         &kp RIGHT
			>;
		};

		/*
		 * Layer 1: Mac (Fn+M toggles it). Only what differs on a Mac:
		 *   Win <-> Alt and the right Alt <-> Super swap, giving Ctrl Opt Cmd Space Cmd
		 *   Opt in Apple's order, so Cmd+C is a thumb away.
		 *   PrtSc = Cmd+Shift+4 (screenshot a region)
		 *   Home / End = Cmd+Left / Right (start / end of line, as on Windows and Linux)
		 */
		mac_layer {
			display-name = "Mac";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LS(LG(N4))   &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LG(LEFT)     &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LG(RIGHT)    &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &kp LALT         &kp LGUI         &trans           &kp RGUI         &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/*
		 * Layer 2: Fn (hold). The highest of the layers you hold, so nothing above it
		 * can hide these keys.
		 *
		 *   system       Esc recovery     F12 Studio unlock   PrtSc/ScrLk/Pause mute vol+ bri+
		 *                Ins/Home/PgUp prev play next   End/PgDn vol- bri-
		 *   connection   1 2 3 6 7 Bluetooth 1-5   4 USB   5 toggle USB/Bluetooth   Del clear BT pairing
		 *   RGB          Bspc on/off   - = speed   [ ] hue   \ Enter effect   Up/Down brightness   B battery
		 *   modes        M Mac mode
		 *   navigation   H J K L arrows   U O Home End   Y N PgUp PgDn   X Bspc   ; Del
		 *   jumps        A D word left / right   W S paragraph up / down
		 *   Space        hold for the Num layer
		 *
		 * Shift, Ctrl, Alt and Cmd stay as they are, so Shift+Fn+L selects and
		 * Shift+Fn+D selects a word. A D W S send Ctrl+Left / Right / Up / Down
		 * (the Mac-specific versions live on layer 3, which the right Win key holds).
		 */
		fn_layer {
			display-name = "Fn";
			bindings = <
				&bootloader      &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &studio_unlock   &trans           &kp C_MUTE       &kp C_VOL_UP     &kp C_BRI_UP
				&trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &out OUT_USB     &out OUT_TOG     &bt BT_SEL 3     &bt BT_SEL 4     &trans           &trans           &trans           &rgb RGB_SPD     &rgb RGB_SPI     &rgb RGB_TOG     &kp C_PREV       &kp C_PP         &kp C_NEXT
				&trans           &trans           &kp LC(UP)       &trans           &trans           &trans           &kp PG_UP        &kp HOME         &trans           &kp END          &trans           &rgb RGB_HUD     &rgb RGB_HUI     &rgb RGB_EFF     &bt BT_CLR       &kp C_VOL_DN     &kp C_BRI_DN
				&trans           &kp LC(LEFT)     &kp LC(DOWN)     &kp LC(RIGHT)    &trans           &trans           &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp DEL          &trans           &rgb RGB_EFF
				&trans           &trans           &kp BSPC         &trans           &tog VIM         &rgb RGB_BAT     &kp PG_DN        &tog MAC         &trans           &trans           &trans           &trans           &rgb RGB_BRI
				&trans           &trans           &trans           &mo NUM          &trans           &trans           &trans           &trans           &trans           &rgb RGB_BRD     &trans
			>;
		};

		/*
		 * Layer 3: MacFn. Held by the right Win key (your numpad on the nav cluster).
		 * It is a plain held layer: an earlier conditional layer for it forced it off
		 * whenever Mac mode was not on, which made the numpad and the macro layer
		 * (Space on this layer) unreachable.
		 * U / O become Cmd+Left / Right, so Fn+U / O still mean start / end of line,
		 * and A D W S become Option+arrows (word and paragraph, the Mac way).
		 */
		mac_fn_layer {
			display-name = "MacFn";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp N0           &kp N7           &kp N8           &kp N9
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp N4           &kp N5           &kp N6
				&trans           &trans           &kp LA(UP)       &trans           &trans           &trans           &trans           &kp LG(LEFT)     &trans           &kp LG(RIGHT)    &trans           &trans           &trans           &trans           &kp N1           &kp N2           &kp N3
				&trans           &kp LA(LEFT)     &kp LA(DOWN)     &kp LA(RIGHT)    &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &mo MACRO        &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/*
		 * Layer 4: Num (hold Fn and Space). Above Fn so it can reuse the HJKL block.
		 *
		 *   right hand  7 8 9 -  /  4 5 6 + =  /  0 1 2 3 .      [ * ]  /  Enter
		 *   left hand   ~ ! @ # $  /  ( ) { } |  /  [ ] < > \

		 */
		num_layer {
			display-name = "Num";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &kp LS(GRAVE)    &kp LS(N1)       &kp LS(N2)       &kp LS(N3)       &kp LS(N4)       &trans           &kp N7           &kp N8           &kp N9           &kp MINUS        &kp LS(N8)       &kp FSLH         &trans           &trans           &trans           &trans
				&trans           &kp LS(N9)       &kp LS(N0)       &kp LS(LBKT)     &kp LS(RBKT)     &kp LS(BSLH)     &trans           &kp N4           &kp N5           &kp N6           &kp LS(EQUAL)    &kp EQUAL        &kp RET
				&trans           &kp LBKT         &kp RBKT         &kp LS(COMMA)    &kp LS(DOT)      &kp BSLH         &kp N0           &kp N1           &kp N2           &kp N3           &kp DOT          &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/*
		 * Layer 5: Macro (hold right Win, then Space). P plays macro 0 (edit it in VIA).
		 * A real layer, not a spare one: ZMK only looks up keys in layers that are
		 * in the keymap file, so a macro key on a reserved spare layer never fires.
		 */
		macro_layer {
			display-name = "Macro";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &vmacro 0        &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/*
		 * Layer 6: Vim (normal mode, Fn+V toggles it). Text editing anywhere: motions, delete,
		 * yank, paste and undo on the usual shortcuts. Keys with no vim meaning do nothing, so
		 * you cannot type by accident; i / a / o / s (or Fn+V) go back to typing. Windows and
		 * Linux shortcuts (Ctrl); on a Mac use the Option/Cmd versions by hand.
		 *   h j k l  arrows        w e b  word right / right / left      0 4  line start / end ($)
		 *   [ ]      paragraph     g G    top / bottom of the file        /    find  n next
		 *   x X      delete / backspace   u (U) undo (redo)   r redo   p paste
		 *   d y c then d y c / w / 4 / 0   delete / yank / change a line, a word, to the end
		 *   D C Y    to end of line / change to end / yank line
		 *   i I a A o O s   back to typing (before, line start, after, line end, new line below / above, replace char)
		 *   v V      visual: select with h j k l w b 0 4 g, then y d c p, v or Esc to cancel
		 */
		vim_layer {
			display-name = "Vim";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&pv_GRAVE        &pv_N1           &pv_N2           &pv_N3           &pv_N4           &pv_N5           &pv_N6           &pv_N7           &pv_N8           &pv_N9           &pv_N0           &pv_MINUS        &pv_EQUAL        &trans           &trans           &trans           &trans
				&trans           &pv_Q            &pv_W            &pv_E            &pv_R            &pv_T            &pv_Y            &pv_U            &pv_I            &pv_O            &pv_P            &pv_LBKT         &pv_RBKT         &pv_BSLH         &trans           &trans           &trans
				&trans           &pv_A            &pv_S            &pv_D            &pv_F            &pv_G            &pv_H            &pv_J            &pv_K            &pv_L            &pv_SEMI         &pv_SQT          &trans
				&trans           &pv_Z            &pv_X            &pv_C            &pv_V            &pv_B            &pv_N            &pv_M            &pv_COMMA        &pv_DOT          &pv_FSLH         &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/* Layer 7: Visual (v in Vim). Motions select; y copies, d / x cuts, c cuts and types, p pastes over. */
		visual_layer {
			display-name = "Visual";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&ps_GRAVE        &ps_N1           &ps_N2           &ps_N3           &ps_N4           &ps_N5           &ps_N6           &ps_N7           &ps_N8           &ps_N9           &ps_N0           &ps_MINUS        &ps_EQUAL        &trans           &trans           &trans           &trans
				&trans           &ps_Q            &ps_W            &ps_E            &ps_R            &ps_T            &ps_Y            &ps_U            &ps_I            &ps_O            &ps_P            &ps_LBKT         &ps_RBKT         &ps_BSLH         &trans           &trans           &trans
				&trans           &ps_A            &ps_S            &ps_D            &ps_F            &ps_G            &ps_H            &ps_J            &ps_K            &ps_L            &ps_SEMI         &ps_SQT          &trans
				&trans           &ps_Z            &ps_X            &ps_C            &ps_V            &ps_B            &ps_N            &ps_M            &ps_COMMA        &ps_DOT          &ps_FSLH         &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/* Layer 8: d pressed in Vim. Lasts one key: d line, w word, 4 to end, 0 to start. */
		opd_layer {
			display-name = "OpD";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&none            &none            &none            &none            &op_d_end        &none            &none            &none            &none            &none            &op_d_home       &none            &none            &trans           &trans           &trans           &trans
				&trans           &none            &kp LC(DEL)      &kp LC(DEL)      &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &trans           &trans           &trans
				&trans           &none            &none            &op_dd           &none            &none            &none            &none            &none            &none            &none            &none            &trans
				&trans           &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/* Layer 9: y pressed in Vim. Lasts one key: y line, w word, 4 to end. */
		opy_layer {
			display-name = "OpY";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&none            &none            &none            &none            &op_y_end        &none            &none            &none            &none            &none            &none            &none            &none            &trans           &trans           &trans           &trans
				&trans           &none            &op_yw           &op_yw           &none            &none            &op_yy           &none            &none            &none            &none            &none            &none            &none            &trans           &trans           &trans
				&trans           &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &trans
				&trans           &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/* Layer 10: c pressed in Vim. Lasts one key: c line, w word, 4 to end; then you are typing. */
		opc_layer {
			display-name = "OpC";
			bindings = <
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&none            &none            &none            &none            &op_c_end        &none            &none            &none            &none            &none            &none            &none            &none            &trans           &trans           &trans           &trans
				&trans           &none            &op_cw           &op_cw           &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &trans           &trans           &trans
				&trans           &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &trans
				&trans           &none            &none            &op_cc           &none            &none            &none            &none            &none            &none            &none            &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
			>;
		};

		/* Layers 11-13: empty slots. VIA shows them as spare layers; ZMK Studio can
		 * turn them into new layers. They must stay last: ZMK numbers the enabled
		 * layers first, so a real layer placed after a reserved one is never
		 * looked up. */
		spare_layer_1 {
			status = "reserved";
		};

		spare_layer_2 {
			status = "reserved";
		};

		spare_layer_3 {
			status = "reserved";
		};
	};
};
