/*
 * Wobkey Crush 80 — stock QWERTY keymap
 *
 * Layer 0: plain 88-key QWERTY, F1-F13 and the arrow cluster; Fn opens layer 1.
 * Layer 1: Fn: Bluetooth profiles 1-3 (1 2 3), USB (4), USB/Bluetooth toggle (5),
 *          Bluetooth clear (Ins), RGB on/off (Bspc), next effect (\), brightness
 *          (Up / Down), bootloader (Esc).
 *
 * The smallest keymap that builds: CRUSH80_KEYMAP=keymaps/stock.keymap bash build.sh
 * Its layer list differs from config/crush80.keymap, so raise CONFIG_CRUSH80_KEYMAP_REV
 * (zmk/Kconfig) when switching either way, or live edits saved for the other layout
 * land on the wrong layers.
 */

#define ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <rainy_rgb.dtsi>
#include <dt-bindings/rainy_rgb.h>

#define BASE 0
#define FN   1

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Base";
			bindings = <
				&kp ESC          &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12          &kp F13          &kp PSCRN        &kp SLCK         &kp PAUSE_BREAK
				&kp GRAVE        &kp N1           &kp N2           &kp N3           &kp N4           &kp N5           &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &kp MINUS        &kp EQUAL        &kp BSPC         &kp INS          &kp HOME         &kp PG_UP
				&kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P            &kp LBKT         &kp RBKT         &kp BSLH         &kp DEL          &kp END          &kp PG_DN
				&kp CAPS         &kp A            &kp S            &kp D            &kp F            &kp G            &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp SQT          &kp RET
				&kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &kp RSHFT        &kp UP
				&kp LCTRL        &kp LGUI         &kp LALT         &kp SPACE        &kp RALT         &mo FN           &kp RGUI         &kp RCTRL        &kp LEFT         &kp DOWN         &kp RIGHT
			>;
		};

		fn_layer {
			display-name = "Fn";
			bindings = <
				&bootloader      &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &out OUT_USB     &out OUT_TOG     &trans           &trans           &trans           &trans           &trans           &trans           &trans           &rgb RGB_TOG     &bt BT_CLR       &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &rgb RGB_EFF     &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &rgb RGB_BRI
				&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &rgb RGB_BRD     &trans
			>;
		};
	};
};
