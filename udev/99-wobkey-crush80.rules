# Wobkey Crush 80: user access for flashing, no sudo needed at flash time.
# Install: sudo cp udev/99-wobkey-crush80.rules /etc/udev/rules.d/ \
#          && sudo udevadm control --reload-rules && sudo udevadm trigger
# TAG+="uaccess" grants the logged-in desktop user access (systemd-logind).

# Stock firmware OTA HID interface (wired, and the 2.4 GHz dongle)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5055", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5088", TAG+="uaccess"

# ZMK app / OTA bridge: CDC ACM serial (Studio, or mcumgr on the bridge) and the
# OpenRGB raw HID interface. ModemManager must not probe the serial port.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="615e", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="615e", TAG+="uaccess"

# MCUboot serial recovery (Fn+Esc, or no valid app): firmware uploads go here.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2fe3", ATTRS{idProduct}=="0100", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
