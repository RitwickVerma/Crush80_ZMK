# Wobkey Crush 80: user access for flashing, no sudo needed at flash time.
# Install: sudo cp udev/99-wobkey-crush80.rules /etc/udev/rules.d/ \
#          && sudo udevadm control --reload-rules && sudo udevadm trigger
# MODE 0666: works from any session (TTY, SSH, containers). uaccess alone only
# reaches the active desktop seat.

# Stock firmware OTA HID interface (wired, and the 2.4 GHz dongle)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5055", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5088", MODE="0666", TAG+="uaccess"

# ZMK app: OpenRGB raw HID interface. OTA bridge: CDC ACM serial (mcumgr);
# ModemManager must not probe it. The app itself has no serial port.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="615e", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="615e", MODE="0666", TAG+="uaccess"

# MCUboot serial recovery (scripts/force_recovery.py, or no valid app):
# firmware uploads go here.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2fe3", ATTRS{idProduct}=="0100", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
