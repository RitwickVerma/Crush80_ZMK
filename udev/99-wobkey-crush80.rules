# Wobkey Crush 80 — USB access for flashing (OTA + mcumgr serial)
# Install: sudo cp 99-wobkey-crush80.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger

# Stock firmware OTA HID interface (wired)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5055", MODE="0660", GROUP="input"
# Stock firmware OTA HID interface (2.4G dongle)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5088", MODE="0660", GROUP="input"

# ZMK / bridge firmware USB CDC-ACM serial port (mcumgr SMP + console)
# MODE 0666 so no group membership is needed for one-shot flashing.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="615e", MODE="0666"
