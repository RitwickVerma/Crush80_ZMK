diff --git a/app/src/studio/hid_rpc_transport.c b/app/src/studio/hid_rpc_transport.c
new file mode 100644
index 00000000..cdcbc24f
--- /dev/null
+++ b/app/src/studio/hid_rpc_transport.c
@@ -0,0 +1,112 @@
+/*
+ * Copyright (c) 2025
+ * SPDX-License-Identifier: MIT
+ *
+ * ZMK Studio RPC transport over USB raw HID (report ID 0x0C).
+ *
+ * The B91 has no spare CDC-ACM (its 256B USB SRAM fits exactly one, already
+ * used by mcumgr), so Studio rides the keyboard HID interface instead:
+ *
+ *   - Host -> device: SET_REPORT (FEATURE, report 0x0C), 16 bytes
+ *   - Device -> host: interrupt IN report 0x0C, 16 bytes
+ *
+ * Wire format of the 15 payload bytes: [seq][len][data0..data12]
+ *   seq : 1-byte sequence number (wraps); lets the client drop the B91 IN
+ *         endpoint's duplicate re-transmits.
+ *   len : number of valid data bytes (0..13).
+ *   data: 13-byte data window, only the first `len` bytes are meaningful,
+ *         rest zero-padded (the HID report is a fixed 16 bytes on the wire).
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/sys/ring_buffer.h>
+#include <zephyr/logging/log.h>
+
+#include <zmk/studio/rpc.h>
+#include <zmk/usb_hid.h>
+#include <zmk/hid.h>
+
+#include <string.h>
+
+LOG_MODULE_DECLARE(zmk_studio, CONFIG_ZMK_STUDIO_LOG_LEVEL);
+
+/* Payload bytes after the report ID (1) that fit in one 16-byte IN packet. */
+#define HID_STUDIO_PAYLOAD ZMK_HID_STUDIO_REPORT_PAYLOAD_SIZE
+/* Payload minus [seq][len] header. */
+#define HID_STUDIO_CHUNK (HID_STUDIO_PAYLOAD - 2)
+
+static uint8_t tx_seq;
+
+static void hid_tx_notify(struct ring_buf *tx_buf, size_t added, bool msg_done, void *user_data) {
+    ARG_UNUSED(user_data);
+
+    if (!msg_done && ring_buf_size_get(tx_buf) <= (ring_buf_capacity_get(tx_buf) / 2)) {
+        return;
+    }
+
+    while (ring_buf_size_get(tx_buf) > 0) {
+        uint8_t payload[HID_STUDIO_PAYLOAD];
+        uint8_t *buf;
+        uint32_t len = ring_buf_get_claim(tx_buf, &buf, HID_STUDIO_CHUNK);
+
+        if (len == 0) {
+            break;
+        }
+
+        payload[0] = tx_seq++;
+        payload[1] = (uint8_t)len;
+        memcpy(&payload[2], buf, len);
+        memset(&payload[2 + len], 0, HID_STUDIO_CHUNK - len);
+
+        ring_buf_get_finish(tx_buf, len);
+
+        if (zmk_usb_hid_send_studio_report(payload, sizeof(payload)) < 0) {
+            LOG_DBG("Studio HID report send failed; dropping chunk");
+        }
+    }
+}
+
+static uint8_t last_rx_seq;
+static bool rx_seq_valid;
+
+void zmk_studio_hid_receive(const uint8_t *payload, size_t len) {
+    if (len < 3) {
+        return;
+    }
+
+    uint8_t seq = payload[0];
+    uint8_t n = payload[1];
+    if (n > len - 2) {
+        n = len - 2;
+    }
+
+    if (rx_seq_valid && seq == last_rx_seq) {
+        /* B91 IN/OUT duplicate re-transmit of the previous report. */
+        return;
+    }
+    last_rx_seq = seq;
+    rx_seq_valid = true;
+
+    struct ring_buf *rx_buf = zmk_rpc_get_rx_buf();
+    uint32_t copied = 0;
+
+    while (copied < n) {
+        uint8_t *buf;
+        uint32_t claim = ring_buf_put_claim(rx_buf, &buf, n - copied);
+
+        if (claim > 0) {
+            memcpy(buf, &payload[2] + copied, claim);
+            copied += claim;
+        }
+
+        ring_buf_put_finish(rx_buf, claim);
+    }
+
+    zmk_rpc_rx_notify();
+}
+
+static int hid_rx_start(void) { return 0; }
+static int hid_rx_stop(void) { return 0; }
+
+ZMK_RPC_TRANSPORT(hid, ZMK_TRANSPORT_USB, hid_rx_start, hid_rx_stop, NULL, hid_tx_notify);
