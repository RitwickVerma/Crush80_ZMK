+#if IS_ENABLED(CONFIG_ZMK_STUDIO_TRANSPORT_USB_HID)
+int zmk_usb_hid_send_studio_report(const uint8_t *payload, size_t len) {
+    uint8_t report[1 + ZMK_HID_STUDIO_REPORT_PAYLOAD_SIZE];
+
+    if (len > ZMK_HID_STUDIO_REPORT_PAYLOAD_SIZE) {
+        return -EINVAL;
+    }
+
+    report[0] = ZMK_HID_REPORT_ID_STUDIO;
+    memcpy(&report[1], payload, len);
+    memset(&report[1 + len], 0, ZMK_HID_STUDIO_REPORT_PAYLOAD_SIZE - len);
+
+    return zmk_usb_hid_send_report(report, sizeof(report));
+}
+#endif /* IS_ENABLED(CONFIG_ZMK_STUDIO_TRANSPORT_USB_HID) */
+
