 #define HID_RAW_EP_MPS			64
+#define HID_VIA_EP_MPS			32
+#define HID_RAW_INSTANCE_EP_MPS(x)					\
+	COND_CODE_1(x, (HID_RAW_EP_MPS), (HID_VIA_EP_MPS))
 
