diff --git a/src/transport/webhid.ts b/src/transport/webhid.ts
new file mode 100644
index 0000000..e5c1df1
--- /dev/null
+++ b/src/transport/webhid.ts
@@ -0,0 +1,105 @@
+import type { RpcTransport } from "@zmkfirmware/zmk-studio-ts-client/transport/index";
+
+// Crush80 raw-HID ZMK Studio transport (report ID 0x0C on the keyboard HID
+// interface). Wire report = [0x0C][seq][len][13 data bytes]. The seq byte lets
+// us drop the B91 IN endpoint's duplicate re-transmits; len delimits the valid
+// data window in the fixed 15-byte payload.
+const REPORT_ID = 0x0c;
+const PAYLOAD = 15; // payload bytes after the report ID
+const CHUNK = PAYLOAD - 2; // payload - [seq][len] header = 13 data bytes
+
+const FILTER = {
+  vendorId: 0x1d50,
+  productId: 0x615e,
+  usagePage: 0x01, // Generic Desktop
+  usage: 0x06, // Keyboard (the interface carrying report 0x0C)
+};
+
+export async function connect(): Promise<RpcTransport> {
+  const devices = await navigator.hid.requestDevice({ filters: [FILTER] });
+  const device = devices[0];
+  if (!device) {
+    throw new Error("No device selected");
+  }
+
+  await device.open();
+
+  const abortController = new AbortController();
+  const label = "Crush 80 (USB HID)";
+
+  // ---- RX: input reports 0x0C -> raw framed byte stream ----
+  let rx_seq: number | null = null;
+  const readable = new ReadableStream<Uint8Array>({
+    start(controller) {
+      const onReport = (e: HIDInputReportEvent) => {
+        if (e.reportId !== REPORT_ID) {
+          return;
+        }
+        const raw = new Uint8Array(
+          e.data.buffer,
+          e.data.byteOffset,
+          e.data.byteLength
+        );
+        // Some browsers include the report ID as raw[0]; handle both.
+        let off = 0;
+        if (raw.length > 0 && raw[0] === REPORT_ID) {
+          off = 1;
+        }
+        if (raw.length < off + 3) {
+          return;
+        }
+        const seq = raw[off];
+        const n = Math.min(raw[off + 1], CHUNK);
+        if (seq === rx_seq) {
+          return; // duplicate re-transmit
+        }
+        rx_seq = seq;
+        if (n > 0) {
+          controller.enqueue(raw.subarray(off + 2, off + 2 + n));
+        }
+      };
+      device.addEventListener("inputreport", onReport);
+      abortController.signal.addEventListener(
+        "abort",
+        () => {
+          device.removeEventListener("inputreport", onReport);
+          try {
+            controller.close();
+          } catch {
+            /* already closed */
+          }
+        },
+        { once: true }
+      );
+    },
+  });
+
+  // ---- TX: raw framed byte stream -> feature reports 0x0C ----
+  let tx_seq = 0;
+  const writable = new WritableStream<Uint8Array>({
+    async write(chunk) {
+      for (let i = 0; i < chunk.length; i += CHUNK) {
+        const n = Math.min(CHUNK, chunk.length - i);
+        const payload = new Uint8Array(PAYLOAD);
+        payload[0] = tx_seq++ & 0xff;
+        payload[1] = n;
+        payload.set(chunk.subarray(i, i + n), 2);
+        await device.sendFeatureReport(REPORT_ID, payload);
+      }
+    },
+  });
+
+  abortController.signal.addEventListener(
+    "abort",
+    async () => {
+      try {
+        await device.close();
+      } catch {
+        /* ignore */
+      }
+    },
+    { once: true }
+  );
+
+  return { label, abortController, readable, writable };
+}
